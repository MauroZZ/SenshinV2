---

<footer class="footer">
  <div class="footer-top">
    <div class="footer-news">
      <h3 class="news-title">Únete al Círculo Senshin</h3>
      <p class="news-desc">
        Acceso exclusivo a lanzamientos de barricas únicas y eventos privados de
        cata en el desierto.
      </p>
      <form class="news-form">
        <input
          class="news-input"
          placeholder="Email corporativo"
          type="email"
        />
        <button class="news-btn">Suscribir</button>
      </form>
    </div>

    <div class="footer-nav-col">
      <h4 class="footer-label">Navegación</h4>
      <ul class="footer-list">
        <li>
          <a class="footer-link" href="/nosotros">La Destilería</a>
        </li>
        <li>
          <a class="footer-link" href="/contacto">Contacto</a>
        </li>
        <li>
          <a class="footer-link" href="/tienda">La Colección</a>
        </li>
        <li>
          <a class="footer-link" href="#">Contacto</a>
        </li>
      </ul>
    </div>

    <div class="footer-nav-col">
      <h4 class="footer-label">Redes</h4>
      <ul class="footer-list">
        <li>
          <a class="footer-link" href="#">Instagram</a>
        </li>
        <li>
          <a class="footer-link" href="#">LinkedIn</a>
        </li>
        <li>
          <a class="footer-link" href="#">Vimeo</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="legal-section">
      <div class="footer-logo">
        <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M44 4H30.6666V17.3334H17.3334V30.6666H4V44H44V4Z"
            fill="currentColor"></path>
        </svg>
      </div>
      <p class="legal-text">
        BEBER CON MODERACIÓN. PROHIBIDA SU VENTA A MENORES DE 18 AÑOS.
      </p>
      <p class="legal-copy">
        © 2024 SENSHIN DISTILLERY. VALLE DEL ELQUI, CHILE.
      </p>
    </div>

    <div class="footer-secondary-links">
      <a class="legal-link" href="#">Privacidad</a>
      <a class="legal-link" href="#">Términos</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: rgba(0, 0, 0, 0.4);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-md);
    padding-left: var(--space-md);
    padding-right: var(--space-md);
    border-top: 1px solid rgba(236, 156, 19, 0.05);
  }

  .footer-top {
    max-width: 1280px;
    margin: 0 auto 80px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: repeat(4, 1fr);
    }
    .footer-news {
      grid-column: span 2;
    }
  }

  .news-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .news-desc {
    color: var(--color-text-dim);
    margin-bottom: var(--space-md);
    max-width: 448px;
    font-weight: 300;
  }

  .news-form {
    display: flex;
    gap: var(--space-xs);
  }

  .news-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: 16px 24px;
    flex: 1;
    outline: none;
    font-size: var(--text-sm);
    color: var(--color-text-main);
    transition: var(--transition-fast);
  }

  .news-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
  }

  .news-btn {
    background-color: var(--color-primary);
    color: var(--color-bg-dark);
    padding: 16px 32px;
    border-radius: var(--radius-xl);
    font-size: var(--text-xs);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    transition: var(--transition-smooth);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .news-btn:hover {
    background-color: var(--color-text-main);
    color: var(--color-text-dark);
    box-shadow: 0 10px 30px rgba(236, 156, 19, 0.2);
  }

  .footer-label {
    color: var(--color-primary);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-weight: 900;
    margin-bottom: var(--space-md);
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-dim);
  }

  .footer-link:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .legal-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .footer-logo {
    color: var(--color-primary);
    width: 32px;
    height: 32px;
    opacity: 0.5;
  }

  .legal-text {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #64748b;
  }

  .legal-copy {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #475569;
  }

  .footer-secondary-links {
    display: flex;
    gap: 32px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #64748b;
  }

  .legal-link:hover {
    color: var(--color-text-main);
  }
</style>
