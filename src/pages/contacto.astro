---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Contacto | Senshin — Consultas, Prensa y Distribución"
    description="Escríbenos para consultas generales, distribución mayorista, prensa o colaboraciones. Senshin: destilería premium chilena de whisky y brandy artesanal."
>
    <!-- Background Elements -->
    <div class="grain-overlay"></div>
    <div class="contact-bg-glow"></div>

    <main class="contacto-wrapper page-content">
        <!-- Section 1: Hero Header -->
        <section class="contact-hero">
            <div class="container hero-container">
                <span class="hero-eyebrow" data-i18n="contacto.eyebrow">Estamos para ayudarte</span>
                <h1 class="hero-title" data-i18n="contacto.title">Contacto</h1>
                <p class="hero-desc" data-i18n="contacto.desc">
                    En Senshin valoramos la cercanía y el profesionalismo. 
                    Cuéntanos tu desafío y busquemos juntos la mejor estrategia para llevar la pureza de los Andes a tu paladar.
                </p>
            </div>
        </section>

        <!-- Section 2: Social Bar -->
        <section class="social-bar-section">
            <div class="container">
                <div class="social-bar">
                    <span class="social-label" data-i18n="contacto.social.label">Encuéntranos en:</span>
                    <div class="social-links">
                        <a href="https://instagram.com/senshinchile" target="_blank" class="social-btn">
                            <span class="material-symbols-outlined">brand_awareness</span>
                            Instagram
                        </a>
                        <a href="https://wa.me/56900000000" target="_blank" class="social-btn">
                            <span class="material-symbols-outlined">chat</span>
                            WhatsApp
                        </a>
                        <a href="https://linkedin.com" target="_blank" class="social-btn">
                            <span class="material-symbols-outlined">group</span>
                            LinkedIn
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 3: Info & Form Grid -->
        <section class="contact-grid-section">
            <div class="container grid-layout">
                <!-- Left: Contact Data -->
                <aside class="contact-info">
                    <h2 class="section-title" data-i18n="contacto.info.title">Datos de contacto</h2>
                    
                    <div class="info-items">
                        <div class="info-item">
                            <div class="info-icon">
                                <span class="material-symbols-outlined">location_on</span>
                            </div>
                            <div class="info-content">
                                <span class="info-label" data-i18n="contacto.info.address.label">Dirección:</span>
                                <p class="info-text">Valle del Elqui, Región de Coquimbo, Chile</p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <span class="material-symbols-outlined">call</span>
                            </div>
                            <div class="info-content">
                                <span class="info-label" data-i18n="contacto.info.phone.label">Teléfono:</span>
                                <p class="info-text">+56 9 1234 5678</p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <span class="material-symbols-outlined">mail</span>
                            </div>
                            <div class="info-content">
                                <span class="info-label" data-i18n="contacto.info.email.label">Email:</span>
                                <p class="info-text">hola@senshin.cl</p>
                            </div>
                        </div>
                    </div>

                    <div class="location-section">
                        <h2 class="location-title" data-i18n="contacto.location.title">Ubicación</h2>
                        <div class="map-container glass-card">
                            <div class="map-placeholder">
                                <span class="material-symbols-outlined map-icon">distance</span>
                                <p data-i18n="contacto.location.map">Ver ubicación en el mapa</p>
                                <button class="map-btn">Cargar Mapa Google</button>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- Right: Form -->
                <section class="contact-form-side">
                    <div class="form-card glass-card">
                        <h2 class="form-title" data-i18n="contacto.form.title">Contáctanos</h2>
                        <p class="form-subtitle" data-i18n="contacto.form.subtitle">Completa el formulario y te responderemos a la brevedad.</p>

                        <form class="contact-form" id="contact-form" action="https://formspree.io/f/xeelpewk" method="POST">
                            <div class="field-float">
                                <input type="text" id="nombre" name="nombre" placeholder="Nombre *" required />
                            </div>
                            
                            <div class="field-float">
                                <input type="email" id="email" name="email" placeholder="Email *" required />
                            </div>

                            <div class="field-float">
                                <select id="asunto" name="asunto">
                                    <option value="" disabled selected>Asunto *</option>
                                    <option value="general">Consulta general</option>
                                    <option value="distribucion">Distribución mayorista</option>
                                    <option value="prensa">Prensa y medios</option>
                                </select>
                            </div>

                            <div class="field-float">
                                <textarea id="mensaje" name="mensaje" rows="4" placeholder="Mensaje *" required></textarea>
                            </div>

                            <button type="submit" class="btn-submit">
                                <span class="material-symbols-outlined">send</span>
                                <span data-i18n="contacto.form.send">Enviar Mensaje</span>
                            </button>
                            
                            <p class="form-disclaimer">
                                Este sitio está protegido por reCAPTCHA y se aplican la <a href="#">Política de Privacidad</a> y los <a href="#">Términos de Servicio</a> de Google.
                            </p>

                            <p class="form-success" id="form-success">¡Mensaje enviado con éxito!</p>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </main>
</Layout>

<style>
    .contacto-wrapper {
        position: relative;
        background-color: var(--color-bg-dark);
        color: var(--color-text-main);
        min-height: 100vh;
        padding-top: var(--nav-height);
        overflow-x: hidden;
    }

    .contact-bg-glow {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 60%;
        background: radial-gradient(circle at 80% 20%, rgba(236, 156, 19, 0.08) 0%, transparent 60%);
        pointer-events: none;
        z-index: 1;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 32px;
    }

    /* --- HERO --- */
    .contact-hero {
        padding: 80px 0 40px;
        position: relative;
        z-index: 10;
    }

    .hero-eyebrow {
        color: var(--color-primary);
        font-size: var(--text-sm);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 24px;
        display: block;
    }

    .hero-title {
        font-size: clamp(48px, 9vw, 110px);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: -0.04em;
        line-height: 0.85;
        margin-bottom: 32px;
        color: #FFFFFF;
    }

    .hero-desc {
        max-width: 580px;
        color: var(--color-text-dim);
        font-size: 18px;
        line-height: 1.6;
        font-weight: 300;
    }

    /* --- SOCIAL BAR --- */
    .social-bar-section {
        margin-bottom: 80px;
        position: relative;
        z-index: 10;
    }

    .social-bar {
        background: #121212;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 100px;
        padding: 16px 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }

    @media (min-width: 768px) {
        .social-bar {
            flex-direction: row;
            justify-content: space-between;
            padding: 12px 48px;
        }
    }

    .social-label {
        color: var(--color-primary);
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
    }

    .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
    }

    .social-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #1a1a1a;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 100px;
        padding: 10px 24px;
        font-size: 13px;
        font-weight: 600;
        color: #e2e8f0;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .social-btn .material-symbols-outlined {
        font-size: 18px;
        color: var(--color-primary);
        opacity: 0.9;
    }

    .social-btn:hover {
        background: #252525;
        border-color: var(--color-primary);
        transform: translateY(-2px);
        color: white;
    }

    /* --- GRID LAYOUT --- */
    .contact-grid-section {
        padding-bottom: 120px;
        position: relative;
        z-index: 10;
    }

    .grid-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 80px;
    }

    @media (min-width: 1024px) {
        .grid-layout {
            grid-template-columns: 0.9fr 1.1fr;
            gap: 100px;
            align-items: start;
        }
    }

    /* Info Side */
    .section-title {
        font-size: 40px;
        font-weight: 700;
        margin-bottom: 40px;
        letter-spacing: -0.01em;
        color: white;
    }

    .info-items {
        display: flex;
        flex-direction: column;
        gap: 32px;
        margin-bottom: 64px;
    }

    .info-item {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .info-icon .material-symbols-outlined {
        color: var(--color-primary);
        font-size: 28px;
    }

    .info-label {
        display: block;
        color: var(--color-primary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 6px;
    }

    .info-text {
        font-size: 18px;
        color: #e2e8f0;
        font-weight: 300;
        line-height: 1.4;
    }

    .location-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 24px;
    }

    /* Map */
    .map-container {
        aspect-ratio: 16 / 10;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1a1a1a;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden;
    }

    .map-placeholder {
        text-align: center;
        padding: 40px;
    }

    .map-icon {
        font-size: 40px;
        color: var(--color-primary);
        margin-bottom: 16px;
    }

    .map-placeholder p {
        margin-bottom: 24px;
        font-weight: 600;
        font-size: 16px;
        color: white;
    }

    /* Map Header Styling */
    .map-btn {
        background: var(--color-primary);
        background: linear-gradient(135deg, var(--color-primary) 0%, #c67e00 100%);
        border: none;
        padding: 12px 28px;
        border-radius: 100px;
        color: var(--color-bg-dark);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .map-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(236, 156, 19, 0.3);
    }

    /* Form Side */
    .form-card {
        padding: 48px;
        background: #121212;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    @media (min-width: 768px) {
        .form-card {
            padding: 64px;
        }
    }

    .form-title {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 12px;
        color: white;
    }

    .form-subtitle {
        color: var(--color-text-dim);
        font-size: 15px;
        margin-bottom: 40px;
        font-weight: 300;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .field-float input,
    .field-float select,
    .field-float textarea {
        width: 100%;
        background: #1c1c1c;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 16px 20px;
        color: white;
        font-family: inherit;
        font-size: 16px;
        outline: none;
        transition: all 0.3s ease;
    }

    .field-float input:focus,
    .field-float select:focus,
    .field-float textarea:focus {
        border-color: var(--color-primary);
        background: #222;
        box-shadow: 0 0 0 4px rgba(236, 156, 19, 0.05);
    }

    /* Placeholder Styling */
    ::placeholder {
        color: rgba(255, 255, 255, 0.4);
        font-size: 14px;
    }

    /* Submit Button (Senshin Amber Gradient) */
    .btn-submit {
        background: var(--color-primary);
        background: linear-gradient(135deg, var(--color-primary) 0%, #c67e00 100%);
        border: none;
        color: var(--color-bg-dark);
        padding: 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        margin-top: 20px;
        cursor: pointer;
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(236, 156, 19, 0.3);
        filter: brightness(1.1);
    }

    .btn-submit .material-symbols-outlined {
        font-size: 20px;
    }

    .form-disclaimer {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.3);
        text-align: center;
        line-height: 1.6;
        margin-top: 32px;
    }

    .form-disclaimer a {
        text-decoration: underline;
        color: var(--color-primary);
    }

    .form-success {
        display: none;
        color: var(--color-primary);
        text-align: center;
        font-weight: 600;
        margin-top: 20px;
        font-size: 14px;
    }

    .form-success.visible {
        display: block;
    }
</style>

<script>
    // Contact Form Logic
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = form?.querySelector(".btn-submit") as HTMLButtonElement;
    const success = document.getElementById("form-success");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.style.opacity = "0.7";
        }

        const data = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: data,
                headers: { Accept: "application/json" },
            });

            if (response.ok) {
                form.reset();
                if (success) success.classList.add("visible");
                setTimeout(() => success?.classList.remove("visible"), 6000);
            } else {
                alert("Hubo un error al enviar el mensaje. Por favor intenta de nuevo.");
            }
        } catch {
            alert("Error de conexión. Por favor verifica tu internet e intenta de nuevo.");
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.style.opacity = "";
            }
        }
    });

    // Google Maps Lazy Loading Logic
    const mapBtn = document.querySelector(".map-btn");
    const mapContainer = document.querySelector(".map-container") as HTMLElement;

    mapBtn?.addEventListener("click", () => {
        if (mapContainer) {
            // Valle del Elqui Coordinates / Embed Link
            const mapHtml = `<iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d110543.914234!2d-70.6!3d-30.0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x969018486000e36b%3A0xe67ec968f8c97e6!2sValle%20de%20Elqui!5e0!3m2!1ses-419!2scl!4v1710526000000!5m2!1ses-419!2scl" 
                width="100%" 
                height="100%" 
                style="border:0; filter: grayscale(1) invert(1) contrast(1.2);" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>`;
            
            mapContainer.innerHTML = mapHtml;
            mapContainer.style.background = "black";
        }
    });
</script>
