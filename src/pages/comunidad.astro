---

<Layout
    title="Comunidad | Senshin — Los Fundadores del Movimiento"
    description="Únete al movimiento Senshin. Conoce a los fundadores que hacen posible la primera destilería premium de Chile y sé parte de la historia desde el principio."
>
    <!-- Subtle Grain and Texture Layers -->
    <div class="grain-overlay"></div>
    <div class="hero-radial-bg"></div>

    <main class="comunidad-main page-content">
        <!-- Hero Section -->
        <section class="hero-comunidad">
            <!-- Hero Backgound Image -->
            <div class="hero-noi-bg">
                <div class="hero-noi-overlay"></div>
                <img 
                  src="https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=2560&auto=format&fit=crop" 
                  alt="Friends celebrating with whisky" 
                  class="hero-noi-image"
                />
            </div>
            <div class="hero-comunidad-content">
            <span class="hero-badge" data-i18n="comunidad.badge"
                >Tributo a la Comunidad</span
            >
            <h1 class="hero-title" data-i18n="comunidad.title">
                Este espíritu es <span class="italic-light">vuestro</span>.
            </h1>
            <p class="hero-desc" data-i18n="comunidad.desc">
                Gracias a quienes financiaron la búsqueda de la pureza. Una oda
                a nuestra comunidad y el legado que construimos juntos en el
                corazón de Chile.
            </p>
            <div class="hero-separator">
                <div class="separator-line"></div>
                <span class="material-symbols-outlined separator-icon"
                    >expand_more</span
                >
                <div class="separator-line"></div>
            </div>
            </div>
        </section>

        <!-- Contributors Section -->
        <section class="contributors-section">
            <!-- Filter Tabs -->
            <div class="filter-tabs">
                <button class="tab-btn active">Fundadores</button>
                <button class="tab-btn">Guardianes</button>
                <button class="tab-btn">Puristas</button>
            </div>

            <!-- Wall of Honor - Featured Grid -->
            <div class="wall-grid">
                <!-- Column 1 -->
                <div class="wall-col">
                    <div class="founder-item">
                        <p class="founder-badge">Fundador 2023</p>
                        <h3 class="founder-name">{founders[0]}</h3>
                    </div>
                    <div class="founder-item">
                        <p class="founder-badge">Fundador 2023</p>
                        <h3 class="founder-name">{founders[1]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[2]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[3]}</h3>
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="wall-col offset">
                    <div class="founder-item">
                        <p class="founder-badge">Fundador 2023</p>
                        <h3 class="founder-name">{founders[4]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[5]}</h3>
                    </div>
                    <div class="founder-item">
                        <p class="founder-badge">Fundador 2023</p>
                        <h3 class="founder-name">{founders[6]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[7]}</h3>
                    </div>
                </div>

                <!-- Column 3 -->
                <div class="wall-col">
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[8]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[9]}</h3>
                    </div>
                    <div class="founder-item">
                        <p class="founder-badge">Fundador 2023</p>
                        <h3 class="founder-name">{founders[10]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[11]}</h3>
                    </div>
                </div>

                <!-- Column 4 -->
                <div class="wall-col offset desktop-only">
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[12]}</h3>
                    </div>
                    <div class="founder-item">
                        <p class="founder-badge">Fundador 2024</p>
                        <h3 class="founder-name">{founders[13]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[14]}</h3>
                    </div>
                    <div class="founder-item dim">
                        <h3 class="founder-name extralight">{founders[15]}</h3>
                    </div>
                </div>
            </div>

            <!-- Extended List -->
            <div class="extended-list">
                {names.map((name) => <span class="extended-name">{name}</span>)}
            </div>

            <!-- Join the Movement Section -->
            <div class="join-movement-card">
                <div class="card-glow"></div>
                <div class="card-content">
                    <div class="card-header">
                        <span
                            class="card-badge"
                            data-i18n="comunidad.join.slots"
                            >Cupos Fundadores: 24/100 Disponibles</span
                        >
                        <h2 class="card-title" data-i18n="comunidad.join.title">
                            Sé parte del Legado
                        </h2>
                    </div>
                    <p class="card-desc" data-i18n="comunidad.join.desc">
                        Nuestra primera edición es limitada. Únete a la lista de
                        espera para asegurar tu lugar entre los fundadores.
                    </p>

                    <div class="card-actions">
                        <button class="join-cta-btn" id="comunidad-open-banner">
                            <span data-i18n="comunidad.join.cta"
                                >Pre-regístrate ahora</span
                            >
                            <span class="material-symbols-outlined"
                                >rocket_launch</span
                            >
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* Hero Background & Overlay (Reused from Tienda) */
    .hero-noi-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .hero-noi-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(10, 9, 8, 0.4) 0%, rgba(10, 9, 8, 0.6) 50%, #0a0908 100%);
        z-index: 10;
    }

    .hero-noi-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.6;
        transform: scale(1.05);
        filter: brightness(0.5);
    }

    .comunidad-main {
        position: relative;
        z-index: 10;
        display: flex;
        min-height: 100vh;
        flex-direction: column;
    }

    .hero-comunidad {
        position: relative;
        height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0 var(--space-md);
    }

    .hero-comunidad-content {
        position: relative;
        z-index: 20;
        text-align: center;
        max-width: 1024px;
        animation: fadeIn 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero-badge {
        margin-bottom: 24px;
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: var(--color-primary);
    }

    .hero-title {
        max-width: 1024px;
        font-size: 60px;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.05em;
        color: var(--color-text-main);
        text-transform: uppercase;
        margin-bottom: 32px;
    }

    @media (min-width: 768px) {
        .hero-title {
            font-size: 80px;
        }
    }

    @media (min-width: 1440px) {
        .hero-title {
            font-size: var(--text-8xl);
        }
    }

    .italic-light {
        font-style: italic;
        font-weight: 200;
        color: var(--color-primary);
    }

    .hero-desc {
        margin-top: 32px;
        max-width: 576px;
        font-size: var(--text-lg);
        font-weight: 300;
        line-height: 1.6;
        color: var(--color-text-dim);
        font-style: italic;
        animation: fadeIn 1.4s ease-out;
    }

    .hero-separator {
        margin-top: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        opacity: 0.4;
        animation: fadeIn 1.6s ease-out;
    }

    .separator-line {
        height: 1px;
        width: 48px;
        background-color: rgba(236, 156, 19, 0.3);
    }

    .separator-icon {
        color: rgba(236, 156, 19, 0.6);
    }

    .contributors-section {
        margin: 0 auto;
        max-width: 1280px;
        padding: 0 32px 160px;
        width: 100%;
    }

    .filter-tabs {
        margin-bottom: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 48px;
        border-bottom: 1px solid rgba(236, 156, 19, 0.1);
    }

    .tab-btn {
        padding-bottom: 16px;
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        color: #64748b;
        transition: var(--transition-fast);
        border-bottom: 2px solid transparent;
        background: none;
    }

    .tab-btn:hover {
        color: #cbd5e1;
    }

    .tab-btn.active {
        color: var(--color-text-main);
        border-bottom-color: var(--color-primary);
    }

    .wall-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 48px 64px;
    }

    @media (min-width: 768px) {
        .wall-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .wall-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .wall-col {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .wall-col.offset {
        padding-top: 48px;
    }

    .desktop-only {
        display: none;
    }

    @media (min-width: 1024px) {
        .desktop-only {
            display: flex;
        }
    }

    .founder-item {
        cursor: default;
        transition: var(--transition-smooth);
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-xl);
        padding: 40px 24px;
        text-align: center;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .founder-item.dim {
        opacity: 1; /* Eliminamos el opacado que escondía los nombres */
    }

    .founder-item:hover, .founder-item.dim:hover {
        opacity: 1;
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.15);
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .founder-badge {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--color-primary);
        font-weight: 700;
        margin-bottom: 8px;
        opacity: 0.8;
    }

    .founder-name {
        font-size: var(--text-2xl);
        font-weight: 300;
        color: #f8fafc;
        transition: var(--transition-fast);
        letter-spacing: -0.01em;
    }

    .founder-item:hover .founder-name {
        color: var(--color-primary);
    }

    .founder-name.extralight {
        font-weight: 300; /* Igualamos peso para no perder legibilidad */
        color: #f8fafc;
    }

    .founder-item.dim:hover .founder-name.extralight {
        color: var(--color-primary);
    }

    .extended-list {
        margin-top: 128px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        font-size: var(--text-sm);
        font-weight: 400;
        color: #cbd5e1;
        text-transform: capitalize;
        letter-spacing: 0.05em;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 80px;
    }

    @media (min-width: 640px) {
        .extended-list {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (min-width: 768px) {
        .extended-list {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    @media (min-width: 1024px) {
        .extended-list {
            grid-template-columns: repeat(6, 1fr);
        }
    }

    .extended-name {
        transition: var(--transition-fast);
        cursor: default;
        opacity: 1;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        padding: 16px;
        border-radius: var(--radius-sm);
        text-align: center;
    }

    .extended-name:hover {
        color: var(--color-bg-dark);
        background: var(--color-primary);
        transform: translateY(-2px);
    }

    /* ── JOIN THE MOVEMENT CARD ── */
    .join-movement-card {
        margin-top: 120px;
        position: relative;
        padding: 80px 40px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(236, 156, 19, 0.1);
        border-radius: var(--radius-md);
        overflow: hidden;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .card-glow {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(236, 156, 19, 0.5),
            transparent
        );
    }

    .card-content {
        position: relative;
        z-index: 1;
        max-width: 600px;
    }

    .card-header {
        margin-bottom: 24px;
    }

    .card-badge {
        display: block;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--color-primary);
        margin-bottom: 16px;
    }

    .card-title {
        font-size: clamp(32px, 5vw, 48px);
        font-weight: 200;
        color: var(--color-text-main);
        line-height: 1.1;
    }

    .card-desc {
        font-size: var(--text-base);
        color: var(--color-text-dim);
        line-height: 1.7;
        margin-bottom: 40px;
        font-style: italic;
    }

    .card-actions {
        display: flex;
        justify-content: center;
    }

    .join-cta-btn {
        display: flex;
        align-items: center;
        gap: 16px;
        background-color: var(--color-primary);
        color: var(--color-bg-dark);
        padding: 20px 48px;
        border-radius: var(--radius-sm);
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        transition: var(--transition-smooth);
        cursor: pointer;
        border: none;
    }

    .join-cta-btn:hover {
        background-color: var(--color-text-main);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .join-cta-btn .material-symbols-outlined {
        font-size: 20px;
        transition: transform 0.4s ease;
    }

    .join-cta-btn:hover .material-symbols-outlined {
        transform: translate(2px, -2px) rotate(10deg);
    }
</style>

<script>
    // Open LaunchBanner from community CTA
    const openBannerBtn = document.getElementById("comunidad-open-banner");
    openBannerBtn?.addEventListener("click", () => {
        const banner = document.getElementById("launch-banner");
        if (banner) {
            banner.classList.remove("dismissed");
            banner.classList.add("visible");
            setTimeout(() => {
                const input = document.getElementById("banner-email");
                input?.focus();
            }, 400);
        }
    });

    // Simple tab switching logic for UI demonstration
    const tabs = document.querySelectorAll(".tab-btn");
    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            tabs.forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");
        });
    });
</script>
